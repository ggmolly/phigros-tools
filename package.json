{
  "name": "phigros-web-save",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "vite build && tsc --noEmit && bun build server/worker.ts --target=bun --outfile=.output/worker.mjs && cp -r drizzle .output/ && git describe --always --dirty > .output/build",
    "generate": "drizzle-kit generate",
    "db": "mkdir -p data/pg && docker run --rm --name phigros-postgres --user $(id -u):$(id -g) -p 127.0.0.1:5432:5432 -e POSTGRES_USER=phigros -e POSTGRES_HOST_AUTH_METHOD=trust -e POSTGRES_INITDB_ARGS=--locale=C -v ./data/pg:/var/lib/postgresql postgres:18",
    "queue": "docker run --rm --name phigros-rabbitmq -p 127.0.0.1:5672:5672 rabbitmq:4",
    "worker": "bun server/worker.ts",
    "seed": "bun server/seed.ts",
    "preview": "vite preview",
    "start": "bun .output/server/index.mjs",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "amqplib": "^2.3.1",
    "drizzle-orm": "0.45.4",
    "fflate": "^0.8.3",
    "isbot": "^5.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "0.32.0",
    "ua-parser-js": "^2.0.10",
    "uqr": "^0.1.3",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@playwright/test": "^1.65.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@rolldown/plugin-babel": "^0.3.1",
    "@types/amqplib": "^0.10.8",
    "@types/bun": "1.4.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "0.31.11",
    "kuroshiro": "^1.2.1",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "nitro": "^3.0.261103-rc",
    "pinyin-pro": "^3.29.5",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wanakana": "^5.3.1"
  }
}
